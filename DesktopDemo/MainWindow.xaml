<Window x:Class="PlayerDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:PlayerDemo"
        Title="音频播放器"
        Width="1180"
        Height="820"
        MinWidth="1040"
        MinHeight="720"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PaperBrush}"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closed="Window_Closed">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="ChromeButton" TargetType="Button">
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E8DDD0"/>
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#F0D8D4"/>
                <Setter Property="Foreground" Value="#6E3030"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TextButton" TargetType="Button">
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SubtitleButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0,4"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TransportButton" TargetType="Button">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="22">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E8DDD0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SeekRepeat" TargetType="RepeatButton">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Seek" TargetType="Slider">
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="16" VerticalAlignment="Center">
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource SeekRepeat}">
                    <Border Height="3" Background="{DynamicResource AccentBrush}" CornerRadius="1.5"/>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource SeekRepeat}">
                    <Border Height="3" Background="#DDD2C6" CornerRadius="1.5"/>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="0" Height="0"/>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Vertical">
          <Setter Property="Width" Value="8"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                  <Track.Thumb>
                    <Thumb>
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Border Background="#D5C8B8" CornerRadius="3" Margin="2,2"/>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PlaylistItem" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#EFE6DA"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E8DDD0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="AlbumRow">
      <Grid Height="64" Margin="8,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="56"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Width="48" Height="48" CornerRadius="10" Background="#E8DDD0" HorizontalAlignment="Left" VerticalAlignment="Center">
          <Image Source="{Binding Art}" Width="48" Height="48" Stretch="UniformToFill">
            <Image.Clip>
              <RectangleGeometry RadiusX="10" RadiusY="10" Rect="0,0,48,48"/>
            </Image.Clip>
          </Image>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,12,0">
          <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="TrackRow">
      <Grid Height="36">
        <Border Width="2" HorizontalAlignment="Left">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="Transparent"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
        </Border>
        <TextBlock Text="{Binding OrderText}" Width="28" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
        <StackPanel Orientation="Horizontal" Margin="44,0,72,0">
          <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding Artist}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                     Margin="14,0,0,0" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding SubtitleMark}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
          <TextBlock Text="重复" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="14,0,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsDuplicate}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
        <TextBlock Text="{Binding DurationText}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                   HorizontalAlignment="Right" Margin="0,0,4,0"/>
      </Grid>
    </DataTemplate>
    <local:LibraryTemplateSelector x:Key="LibraryTemplates" AlbumTemplate="{StaticResource AlbumRow}" TrackTemplate="{StaticResource TrackRow}"/>
  </Window.Resources>

  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="音频播放器" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="16,0,4,0"/>
        <Button x:Name="PlayNav" Grid.Column="1" Content="播放" Style="{StaticResource TextButton}" Click="PlayNav_Click"/>
        <Button x:Name="SettingsNav" Grid.Column="2" Content="设置" Style="{StaticResource TextButton}" Click="Settings_Click"/>
        <Button x:Name="CrawlNav" Grid.Column="3" Content="爬取" Style="{StaticResource TextButton}" Click="Crawl_Click"/>
        <Button Grid.Column="4" Content="打开文件" Style="{StaticResource TextButton}" Click="OpenFiles_Click"/>
        <Button Grid.Column="5" Content="打开文件夹" Style="{StaticResource TextButton}" Click="OpenFolder_Click"/>
        <StackPanel Grid.Column="7" Orientation="Horizontal">
          <Button Content="&#x2014;" Style="{StaticResource ChromeButton}" Click="Min_Click"/>
          <Button Content="&#x25A1;" Style="{StaticResource ChromeButton}" FontSize="11" Click="Max_Click"/>
          <Button Content="&#x2715;" Style="{StaticResource CloseButton}" Click="Close_Click"/>
        </StackPanel>
      </Grid>

      <Grid x:Name="PlayerPage" Grid.Row="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="96"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="48,28,48,8" VerticalAlignment="Top">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="332"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <StackPanel x:Name="CoverBlock">
            <Border Width="300" Height="300" Background="#E7DDD0" HorizontalAlignment="Left" CornerRadius="18"
                    Cursor="Hand" ToolTip="双击打开封面" MouseLeftButtonDown="Cover_MouseLeftButtonDown">
              <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.16" Color="#6A5344"/>
              </Border.Effect>
              <Border CornerRadius="18" ClipToBounds="True">
                <Border.Clip>
                  <RectangleGeometry Rect="0,0,300,300" RadiusX="18" RadiusY="18"/>
                </Border.Clip>
                <Image x:Name="ArtImage" Width="300" Height="300" Stretch="UniformToFill"/>
              </Border>
            </Border>
            <Grid x:Name="SeekBar" Height="28" Margin="0,16,0,0" Background="Transparent" Cursor="Hand"
                  MouseLeftButtonDown="SeekBar_MouseLeftButtonDown"
                  MouseMove="SeekBar_MouseMove"
                  MouseLeftButtonUp="SeekBar_MouseLeftButtonUp"
                  SizeChanged="SeekBar_SizeChanged">
              <Border Height="4" VerticalAlignment="Center" Background="#E3D5C6" CornerRadius="2"/>
              <Border x:Name="SeekFill" Height="4" Width="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Background="{DynamicResource AccentBrush}" CornerRadius="2" IsHitTestVisible="False"/>
              <Ellipse x:Name="SeekThumb" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Fill="{DynamicResource AccentBrush}" IsHitTestVisible="False"/>
            </Grid>
            <Grid Margin="0,2,0,0">
              <TextBlock x:Name="PositionText" Text="0:00" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Left"/>
              <TextBlock x:Name="DurationText" Text="0:00" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Right"/>
            </Grid>
          </StackPanel>

          <Grid Grid.Column="1" Margin="36,0,0,0" Height="{Binding ActualHeight, ElementName=CoverBlock}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="OutputText" Text="共享" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="8,0,0,0"
                           TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <TextBlock x:Name="TitleText" Text="没有正在播放" FontSize="26" FontWeight="SemiBold"
                         Foreground="{DynamicResource InkBrush}" Margin="0,16,0,0"
                         TextWrapping="Wrap" MaxHeight="72" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="ArtistText" Foreground="{DynamicResource MutedBrush}" FontSize="14" Margin="0,8,0,0"
                         TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="AlbumText" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,2,0,0"
                         TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <WrapPanel Grid.Row="1" VerticalAlignment="Center">
              <Button Content="生成字幕" Margin="0,0,14,8" Click="GenerateCue_Click" Style="{StaticResource SubtitleButton}"/>
              <Button Content="生成字幕和翻译" Margin="0,0,14,8" Click="GenerateBoth_Click" Style="{StaticResource SubtitleButton}"/>
              <Button Content="生成翻译" Margin="0,0,14,8" Click="TranslateOnly_Click" Style="{StaticResource SubtitleButton}"/>
              <Button x:Name="LanguageButton" Content="隐藏原文" Margin="0,0,14,8" Click="Language_Click" Style="{StaticResource SubtitleButton}"/>
              <Button x:Name="CancelJobButton" Content="中止" Margin="0,0,14,8" Click="CancelJob_Click" Style="{StaticResource SubtitleButton}" Visibility="Collapsed"/>
            </WrapPanel>
            <Button x:Name="SubtitleButton" Grid.Row="2" Content="没有字幕" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="0,8,0,0" Click="SubtitleButton_Click" Style="{StaticResource SubtitleButton}"/>
          </Grid>
        </Grid>

        <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0">
          <Grid Margin="28,10,28,4">
            <Grid.RowDefinitions>
              <RowDefinition Height="36"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="16,0,16,0">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BackButton" Content="返回" Style="{StaticResource QuietButton}" Padding="10,3" Margin="0,0,10,0"
                        Visibility="Collapsed" Click="Back_Click"/>
                <TextBlock x:Name="ListTitle" Text="专辑" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="420"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ToggleButton x:Name="ShowDuplicates" Content="显示重复" Style="{StaticResource PaperChip}" Padding="10,3" Margin="0,0,14,0"
                              Checked="ShowDuplicates_Changed" Unchecked="ShowDuplicates_Changed"/>
                <TextBlock Text="时间" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
              </StackPanel>
            </Grid>
            <ListBox x:Name="Playlist" Grid.Row="1"
                     Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource PlaylistItem}"
                     ItemTemplateSelector="{StaticResource LibraryTemplates}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="False"
                     VirtualizingPanel.IsVirtualizing="True"
                     PreviewMouseLeftButtonUp="Playlist_PreviewMouseLeftButtonUp"
                     MouseDoubleClick="Playlist_MouseDoubleClick"
                     SelectionChanged="Playlist_SelectionChanged"/>
            <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="把音频拖到窗口里" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="24,0" FontSize="13"/>
          </Grid>
        </Border>
        </Grid>

      <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="20,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid VerticalAlignment="Center" Margin="0,0,12,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="DeviceBox" Width="220" VerticalAlignment="Center" SelectionChanged="DeviceBox_SelectionChanged"/>
            <ToggleButton x:Name="ExclusiveBox" Grid.Column="1" Content="独占" Margin="12,0" VerticalAlignment="Center"
                          Style="{StaticResource PaperChip}" IsChecked="False"
                          Checked="ExclusiveBox_Changed" Unchecked="ExclusiveBox_Changed"/>
            <TextBlock x:Name="DeviceText" Grid.Column="2" Text="" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="8,0"/>
          </Grid>
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Style="{StaticResource TransportButton}" ToolTip="上一首" Click="Prev_Click">
              <Path Width="16" Height="16" Stretch="Fill" Fill="{DynamicResource InkBrush}" Data="M14,1 L5,8 14,15 Z M3,1 H1 V15 H3 Z"/>
            </Button>
            <Button Width="72" Height="72" Margin="8,0" ToolTip="播放" Click="Play_Click" Focusable="False" BorderThickness="0" Background="Transparent">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border Background="Transparent">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                </ControlTemplate>
              </Button.Template>
              <Grid Width="72" Height="72">
                <Ellipse Fill="{DynamicResource PlayFillBrush}"/>
                <Grid Width="22" Height="22">
                  <Path x:Name="PlayGlyph" Stretch="Fill" Fill="#F6F1EA" Data="M3,1 L3,21 20,11 Z"/>
                  <Path x:Name="PauseGlyph" Stretch="Fill" Fill="#F6F1EA" Visibility="Collapsed"
                        Data="M2,1 H8 V21 H2 Z M14,1 H20 V21 H14 Z"/>
                </Grid>
              </Grid>
            </Button>
            <Button Style="{StaticResource TransportButton}" ToolTip="下一首" Click="Next_Click">
              <Path Width="16" Height="16" Stretch="Fill" Fill="{DynamicResource InkBrush}" Data="M2,1 L11,8 2,15 Z M13,1 H15 V15 H13 Z"/>
            </Button>
            <Button Style="{StaticResource TransportButton}" ToolTip="停止并放开设备" Click="Stop_Click" Margin="4,0,0,0">
              <Path Width="12" Height="12" Stretch="Fill" Fill="{DynamicResource InkBrush}" Data="M0,0 H12 V12 H0 Z"/>
            </Button>
          </StackPanel>
          <DockPanel Grid.Column="2" LastChildFill="True" VerticalAlignment="Center" HorizontalAlignment="Right" Width="160">
            <TextBlock Text="音量" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Grid x:Name="VolumeBar" Height="22" Background="Transparent" Cursor="Hand"
                  MouseLeftButtonDown="VolumeBar_MouseLeftButtonDown"
                  MouseMove="VolumeBar_MouseMove"
                  MouseLeftButtonUp="VolumeBar_MouseLeftButtonUp"
                  SizeChanged="VolumeBar_SizeChanged">
              <Border Height="4" VerticalAlignment="Center" Background="#E3D5C6" CornerRadius="2"/>
              <Border x:Name="VolumeFill" Height="4" Width="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Background="{DynamicResource AccentBrush}" CornerRadius="2" IsHitTestVisible="False"/>
            </Grid>
          </DockPanel>
        </Grid>
      </Border>
      </Grid>

      <local:SettingsPage x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed"/>
      <local:CrawlPage x:Name="CrawlPage" Grid.Row="1" Visibility="Collapsed"/>

      <Popup x:Name="SubtitlePopup"
             PlacementTarget="{Binding ElementName=SubtitleButton}"
             Placement="Top"
             StaysOpen="False"
             AllowsTransparency="True">
        <Border Background="{DynamicResource PaperBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" MinWidth="240" MaxHeight="280">
          <ListBox x:Name="SubtitleMenu"
                   Background="Transparent"
                   BorderThickness="0"
                   Foreground="{DynamicResource InkBrush}"
                   ItemContainerStyle="{StaticResource PlaylistItem}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   SelectionChanged="SubtitleMenu_SelectionChanged"/>
        </Border>
      </Popup>
    </Grid>
  </Border>
</Window>
